APP_NAME="Family Tree Platform Indonesia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://palegoldenrod-sheep-834800.hostingersite.com

# Owner aktif untuk seed opsional Bani Fahruroji di produksi.
BANI_FAHRUROJI_OWNER_EMAIL=
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
TELESCOPE_ENABLED=false
BACKUP_DISK=local
BACKUP_NOTIFICATION_EMAIL=
BACKUP_ARCHIVE_PASSWORD=

# Diambil dari hPanel Hostinger -> Databases -> MySQL Databases.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u407782993_family_tree
DB_USERNAME=u407782993_family_tree
DB_PASSWORD=

# Business Web Hosting tidak menyediakan Redis (hanya VPS).
# Gunakan driver database, tabelnya sudah dibuat oleh migrasi bawaan Laravel.
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# FCM v1-compatible endpoint and short-lived OAuth access token.
PUSH_ENDPOINT=
PUSH_ACCESS_TOKEN=

# Opsi A - mailbox Hostinger (gratis, termasuk paket hosting Business).
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@hostingersite.hazatha.com
MAIL_PASSWORD=!Noreply3!!
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@hostingersite.hazatha.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=palegoldenrod-sheep-834800.hostingersite.com

# Access token lifetime (minutes) and refresh token lifetime (minutes).
SANCTUM_EXPIRATION=120
SANCTUM_REFRESH_TOKEN_TTL=43200
